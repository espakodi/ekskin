<?xml version="1.0" encoding="UTF-8"?>
<!-- EKSkin Repository: punto de entrada para instalar y actualizar la skin.
     Esquema <dir> (el unico que acepta Kodi 21), <checksum> sin verify y sin
     <hashes>: GitHub Pages no emite content-sha256 ni sidecars. -->
<addon id="repository.ekskin" name="EKSkin Repository" version="1.0.0" provider-name="RubénSDFA1laberot">
	<extension point="xbmc.addon.repository" name="EKSkin Repository">
		<dir>
			<info compressed="false">https://espakodi.github.io/ekskin/addons.xml</info>
			<checksum>https://espakodi.github.io/ekskin/addons.xml.md5</checksum>
			<datadir zip="true">https://espakodi.github.io/ekskin/</datadir>
		</dir>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="es_ES">Repositorio de EKSkin</summary>
		<summary lang="en_US">EKSkin Repository</summary>
		<description lang="es_ES">Repositorio oficial para instalar y actualizar EKSkin, skin para Kodi con siete escritorios de sistemas operativos, basada en Estuary.</description>
		<description lang="en_US">Official repository to install and update EKSkin, a Kodi skin with seven operating system desktops, based on Estuary.</description>
		<disclaimer lang="es_ES">Skin de terceros; se puede desinstalar sin riesgo.</disclaimer>
		<disclaimer lang="en_US">Third-party skin; safe to uninstall.</disclaimer>
		<platform>all</platform>
		<license>CC BY-SA 4.0</license>
		<forum>https://github.com/espakodi/ekskin/issues</forum>
		<source>https://github.com/espakodi/ekskin</source>
		<assets>
			<icon>icon.png</icon>
			<fanart>fanart.jpg</fanart>
		</assets>
	</extension>
</addon>
